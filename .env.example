# Base URL of the Learnova backend. Change this one value to point the
# admin dashboard at local / staging / production without touching code.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Clerk (the admin panel signs in through the same Clerk project as the
# mobile app  the backend's requireAdmin middleware checks role==="admin"
# on the matching Mongo user, so promote an account to admin there first)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
